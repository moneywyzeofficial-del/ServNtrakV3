# Database configuration
DATABASE_URL=postgresql://username:password@localhost:5432/servntrak_db

# Session secret for express-session (generate a secure random string)
SESSION_SECRET=your-super-secret-session-key-here

# Email service (Resend)
RESEND_API_KEY=re_123456789

# AI service (Anthropic)
ANTHROPIC_API_KEY=sk-ant-123456789

# Push notifications (VAPID keys - generate using web-push library)
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_EMAIL=your-email@example.com

# Optional: Rate limits
# SCAN_DOCUMENT_RATE_LIMIT=10
# ASSISTANT_RATE_LIMIT=30

# Optional: Object storage
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=